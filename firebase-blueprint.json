{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile document",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" }
      },
      "required": ["user_id", "email"]
    },
    "Order": {
      "title": "Order",
      "description": "Order placed in Marmita Hub",
      "type": "object",
      "properties": {
        "order_id": { "type": "string" },
        "user_id": { "type": "string" },
        "customer_name": { "type": "string" },
        "customer_phone": { "type": "string" },
        "delivery_type": { "type": "string" },
        "address": { "type": "string" },
        "total": { "type": "number" },
        "status": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["order_id", "user_id", "total", "status"]
    },
    "Product": {
      "title": "Product",
      "description": "Marmita or beverage item",
      "type": "object",
      "properties": {
        "product_id": { "type": "string" },
        "user_id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "active": { "type": "boolean" }
      },
      "required": ["product_id", "user_id", "name", "price"]
    },
    "Courier": {
      "title": "Courier",
      "description": "Delivery courier for Marmita Hub",
      "type": "object",
      "properties": {
        "courier_id": { "type": "string" },
        "user_id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "vehicle": { "type": "string" }
      },
      "required": ["courier_id", "user_id", "name"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer record and preferences",
      "type": "object",
      "properties": {
        "customer_id": { "type": "string" },
        "user_id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["customer_id", "user_id", "name", "phone"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User documents"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Orders collection"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Products catalog"
    },
    "/couriers/{courierId}": {
      "schema": "Courier",
      "description": "Couriers collection"
    },
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "Customers collection"
    }
  }
}
